{{#each AdditionalIncludes}}
#include "{{IncludePath}}"
{{/each}}
{{#each InterfaceIncludes}}
#include "{{IncludePath}}"
{{/each}}
#include "{{ClassName}}.generated.h"

{{#each Delegates}}
{{DelegateDeclaration}};

{{/each}}
UCLASS({{ClassSpecifiers}})
class {{ModuleAPI}} {{OwnerClassName}} : public {{ParentClassName}}{{Interfaces}}
{
    GENERATED_BODY()

public:
    {{OwnerClassName}}();

{{#each Properties}}
    UPROPERTY({{PropertySpecifiers}})
    {{PropertyType}} {{PropertyName}}{{PropertyDefault}};

{{/each}}
{{#each Delegates}}
{{DelegatePropertyLine}}
    {{DelegateTypeName}} {{DelegateName}};

{{/each}}
{{#each Functions}}
{{FunctionDeclaration}}

{{/each}}
{{#if Replicated}}
    virtual void GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const override;

{{/if}}
{{#each RPCs}}
    UFUNCTION({{RPCSpecifiers}})
    void {{RPCName}}({{RPCParams}});

{{/each}}
{{#if HasNativeEventFunctions}}
protected:
{{/if}}
{{#each NativeEventFunctions}}
    virtual {{FunctionReturnType}} {{FunctionName}}_Implementation({{FunctionParams}}){{ConstQualifier}};

{{/each}}
{{#if HasRepNotifyProperties}}
protected:
{{/if}}
{{#each RepNotifyProperties}}
    UFUNCTION()
    void OnRep_{{PropertyName}}();

{{/each}}
};
